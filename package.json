{
  "name": "simple-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:start": "docker-compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker-compose -f docker-compose.dev.yml down",
    "db:init": "node scripts/db/init.js",
    "db:seed": "node scripts/db/seed.js",
    "db:clear": "node scripts/db/clear.js",
    "db:reset": "node scripts/db/clear.js && node scripts/db/seed.js"
  },
  "repository": "https://github.com/mister-asia/simple-backend.git",
  "author": "Александр Алиновский <aalinovskiy@alfabank.ru>",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^4.25.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.16",
    "nodemon": "^3.1.0",
    "vitest": "^4.0.16"
  }
}

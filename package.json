{
  "name": "simple-backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:init": "node scripts/init.js",
    "db:seed": "node scripts/seed.js",
    "db:clear": "node scripts/clear.js",
    "db:reset": "npm run db:clear && npm run db:seed",
    "db:setup": "npm run db:init && npm run db:seed"
  },
  "repository": "https://github.com/mister-asia/simple-backend.git",
  "author": "Александр Алиновский <aalinovskiy@alfabank.ru>",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^4.25.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.16",
    "vitest": "^4.0.16"
  }
}

# Пример файла для локальной разработки
# Скопируйте в docker-compose.override.yml если нужно запускать только БД в Docker, а приложение локально

version: '3.8'

services:
  app:
    # Комментируем сервис app для локальной разработки
    # Приложение будет запускаться локально через yarn dev
    profiles:
      - disabled
